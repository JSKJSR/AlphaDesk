# ============================================
# TradingAgents - Claude Code Edition
# ============================================
# This version uses Claude Code CLI which leverages your Claude Pro subscription.
# NO API keys required for LLM access!

# Alpha Vantage API Key (Optional - for company fundamentals/overview)
# Get free key from: https://www.alphavantage.co/support/#api-key
# Only needed for get_fundamentals tool - everything else uses free yfinance/google
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Reddit API (Optional - for social sentiment analysis)
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TradingAgents/1.0

# ============================================
# IMPORTANT: Claude Code Setup
# ============================================
# Before running, make sure Claude Code CLI is installed and authenticated:
#
# 1. Install Claude Code:
#    npm install -g @anthropic-ai/claude-code
#
# 2. Authenticate (run once):
#    claude
#    (Follow the prompts to log in with your Claude Pro account)
#
# 3. Verify it works:
#    claude -p "Hello, are you working?"
